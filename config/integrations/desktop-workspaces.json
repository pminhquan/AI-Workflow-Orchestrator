{
  "schema_version": "desktop-inbox.workspaces@1",
  "default_checks": {
    "noop": {
      "args": ["-e", "process.stdout.write('ok\\n')"],
      "inputs": ["README.md"],
      "timeout_ms": 2000
    }
  },
  "workspaces": [
    {
      "workspace_root": ".",
      "allow_new_conversation": false,
      "checks": {
        "validate": {
          "args": ["src/cli.mjs", "validate"],
          "inputs": ["config", "agents/roles", "workflows", "src/compiler"],
          "timeout_ms": 4500
        },
        "unit-desktop-inbox": {
          "args": ["--test", "tests/unit/desktop-inbox.test.mjs"],
          "inputs": ["src/desktop-inbox", "tests/unit/desktop-inbox.test.mjs"],
          "timeout_ms": 4500
        }
      }
    }
  ]
}
