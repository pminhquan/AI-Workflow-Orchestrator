{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "components@1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "activation": {
      "const": "foundation-only"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "logical_component": {
            "type": "string",
            "minLength": 1
          },
          "canonical_source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "installed_target_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider_runtime": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "deployment_method": {
            "type": "string",
            "minLength": 1
          },
          "installation_status": {
            "type": "string",
            "minLength": 1
          },
          "drift_status": {
            "type": "string",
            "minLength": 1
          },
          "permission_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "rollback_method": {
            "type": "string",
            "minLength": 1
          },
          "management": {
            "enum": [
              "legacy-reference",
              "app-owned",
              "staged"
            ]
          }
        },
        "required": [
          "logical_component",
          "canonical_source_path",
          "installed_target_path",
          "provider_runtime",
          "source_version",
          "content_hash",
          "deployment_method",
          "installation_status",
          "drift_status",
          "permission_requirements",
          "rollback_method",
          "management"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "activation",
    "components"
  ],
  "additionalProperties": false
}
