{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-brief@1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "relevant_files": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[A-Za-z0-9_.@ -]+(?:/[A-Za-z0-9_.@ -]+)*$"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
      },
      "uniqueItems": true
    },
    "read_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[A-Za-z0-9_.@ -]+(?:/[A-Za-z0-9_.@ -]+)*$"
      },
      "uniqueItems": true
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[A-Za-z0-9_.@ -]+(?:/[A-Za-z0-9_.@ -]+)*$"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[A-Za-z0-9_.@ -]+(?:/[A-Za-z0-9_.@ -]+)*$"
      },
      "uniqueItems": true
    },
    "allowed_execution_mode": {
      "enum": [
        "DIRECT",
        "DELEGATED",
        "TEAM"
      ]
    },
    "retry_budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "parent_id",
    "trace_id",
    "goal",
    "workspace",
    "relevant_files",
    "dependencies",
    "read_scope",
    "write_scope",
    "constraints",
    "acceptance_criteria",
    "required_checks",
    "expected_artifacts",
    "allowed_execution_mode",
    "retry_budget"
  ],
  "additionalProperties": false
}
