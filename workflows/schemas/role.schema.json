{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role@1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "role_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "activation_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "inherit-parent",
            "read-only",
            "task-scope"
          ]
        },
        "read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "network": {
          "const": "inherit-parent"
        }
      },
      "required": [
        "mode",
        "read",
        "write",
        "network"
      ],
      "additionalProperties": false
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "input_contract": {
      "const": "task-brief@1.0"
    },
    "output_contract": {
      "const": "worker-report@1.0"
    },
    "verification_responsibility": {
      "type": "string",
      "minLength": 1
    },
    "escalation_behavior": {
      "type": "string",
      "minLength": 1
    },
    "supported_runtimes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "context_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reuse": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "required": [
          "repository",
          "path",
          "reuse",
          "commit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "role_id",
    "purpose",
    "activation_criteria",
    "required_capabilities",
    "permissions",
    "allowed_tools",
    "input_contract",
    "output_contract",
    "verification_responsibility",
    "escalation_behavior",
    "supported_runtimes",
    "context_requirements",
    "source_provenance"
  ],
  "additionalProperties": false
}
