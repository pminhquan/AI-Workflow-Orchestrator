{
  "schema_version": "1.0",
  "recipe_id": "verification-review",
  "trigger_kind": "review",
  "planning_depth": "standard",
  "required_inputs": [
    "diff or artifact",
    "required checks"
  ],
  "suggested_roles": [
    "code-reviewer",
    "evidence-auditor"
  ],
  "breakdown_strategy": "separate claims and evidence",
