  "recovery_conditions": [
    "failed check: bounded rework",
    "unavailable worker: DIRECT if critical requirements survive",
    "scope violation: BLOCKED"
  ],
  "completion_criteria": [
    "accepted artifacts",
    "fresh evidence",
    "integration owner review"
  ],
  "direct_fallback": true
}
